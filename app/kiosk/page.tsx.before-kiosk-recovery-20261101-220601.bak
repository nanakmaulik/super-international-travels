'use client';
import {useEffect,useRef,useState} from 'react';
import Image from 'next/image';

function KioskBrand(){
  return (
    <div className="kioskBrand">
      <Image src="/zavpi-logo.png" alt="Zavpi" width={170} height={46} priority style={{width:'auto',height:'auto',maxWidth:'100%'}} />
    </div>
  );
}

export default function Kiosk(){
  const [token,setToken]=useState(''),
        [entry,setEntry]=useState(''),
        [time,setTime]=useState(new Date()),
        [status,setStatus]=useState(''),
        [busy,setBusy]=useState(false),
        [ready,setReady]=useState(false),
        v=useRef<HTMLVideoElement>(null),
        stream=useRef<MediaStream|null>(null);

  useEffect(()=>{
    setToken(localStorage.getItem('workpulse-kiosk-token')||'');
    const t=setInterval(()=>setTime(new Date()),1000);
    return()=>{
      clearInterval(t);
      stream.current?.getTracks().forEach(x=>x.stop())
    }
  },[]);

  async function start(){
    try{
      const s=await navigator.mediaDevices.getUserMedia({video:{facingMode:'user',width:800,height:600},audio:false});
      stream.current=s;
      if(v.current)v.current.srcObject=s;
      setReady(true);
      setStatus('Camera ready. Choose CLOCK IN or CLOCK OUT.');
    }catch(e:any){
      setStatus('Camera error: '+e.message)
    }
  }

  async function punch(event_type:'in'|'out'){
    if(!ready||!v.current?.videoWidth)return setStatus('Start camera first');
    setBusy(true);
    setStatus('Recognizing face securely…');
    try{
      const c=document.createElement('canvas');
      c.width=640;
      c.height=Math.round(v.current.videoHeight/v.current.videoWidth*640);
      c.getContext('2d')!.drawImage(v.current,0,0,c.width,c.height);
      const r=await fetch('/api/kiosk/punch',{
        method:'POST',
        headers:{'Content-Type':'application/json','x-kiosk-token':token},
        body:JSON.stringify({image:c.toDataURL('image/jpeg',.84),event_type})
      });
      const j=await r.json();
      if(!r.ok)throw Error(j.error||'Punch failed');
      setStatus(`✅ ${j.employee} — ${event_type==='in'?'CLOCKED IN':'CLOCKED OUT'} at ${new Date(j.time).toLocaleTimeString()}`);
      setEntry(event_type);
    }catch(e:any){
      setStatus('⚠ '+e.message)
    }finally{
      setBusy(false)
    }
  }

  return <div className="kioskpage">
    <div className="kioskhead">
      <KioskBrand />
      <span className="badge">Office kiosk</span>
    </div>

    <div className="kioskcard">
      <div className="eyebrow" style={{color:'#aab9cf'}}>SHARED FACE ATTENDANCE</div>
      <div className="bigtime">{time.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}</div>
      <p>{time.toLocaleDateString([],{weekday:'long',year:'numeric',month:'long',day:'numeric'})}</p>

      {!token
        ? <div className="stack">
            <p>Enter the kiosk token generated by your company admin.</p>
            <input className="input" type="password" value={entry} onChange={e=>setEntry(e.target.value)} placeholder="Paste secure device token"/>
            <button className="btn" onClick={()=>{
              if(entry.length!==64)return setStatus('Token must be 64 characters');
              localStorage.setItem('workpulse-kiosk-token',entry);
              setToken(entry);
              setStatus('Device token saved in this browser.');
            }}>Activate Device</button>
          </div>
        : <div className="stack">
            <video ref={v} className="video" autoPlay playsInline muted style={{maxHeight:390,aspectRatio:'4/3'}}/>
            {!ready&&<button className="btn" onClick={start}>Start Camera</button>}
            <div className="kioskactions">
              <button className="btn green" disabled={busy||!ready} onClick={()=>punch('in')}>↳ CLOCK IN</button>
              <button className="btn red" disabled={busy||!ready} onClick={()=>punch('out')}>↗ CLOCK OUT</button>
            </div>
            <button className="btn secondary" onClick={()=>{
              if(confirm('Deactivate device from this browser?')){
                localStorage.removeItem('workpulse-kiosk-token');
                setToken('');
                stream.current?.getTracks().forEach(x=>x.stop());
                setReady(false);
              }
            }}>Change kiosk token</button>
          </div>
      }

      {status&&<div className={status.startsWith('⚠')?'message err':'banner'} style={{marginTop:15}}>{status}</div>}
      <p style={{fontSize:12,color:'#bac8dd'}}>One person per scan • Authorized devices only • Facial recognition is not liveness verification</p>
    </div>
  </div>
}
