:root{font-family:Inter,Arial,sans-serif;color:#19253c;background:#f5f7fb}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer}a{color:inherit;text-decoration:none}.shell{display:flex;min-height:100vh}.sidebar{background:#142238;color:#e6edfc;width:248px;padding:26px 16px;position:sticky;top:0;height:100vh;flex-shrink:0}.brand{font-size:23px;font-weight:850;letter-spacing:-.8px;padding:10px 12px 30px}.brand span{color:#74d5bb}.nav{width:100%;padding:13px 14px;border:0;background:none;color:#bac7da;text-align:left;border-radius:11px;margin:3px 0;font-weight:600}.nav:hover,.nav.active{background:#30435d;color:white}.main{width:100%;padding:29px max(20px,4vw);overflow:hidden}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:27px}.top h1{margin:0;font-size:29px;letter-spacing:-1px}.muted{color:#758298}.eyebrow{color:#758298;font-weight:600;font-size:13px}.badge{background:#dcf6ea;color:#14764b;padding:6px 11px;border-radius:20px;font-size:12px;font-weight:800}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.card{background:#fff;border:1px solid #e4e9f1;border-radius:18px;padding:21px;box-shadow:0 4px 15px #12243f07}.card h3{margin:0 0 12px;font-size:15px}.metric{font-size:31px;font-weight:800;letter-spacing:-1px;margin-top:9px}.btn{border:0;background:#315ce7;color:#fff;border-radius:11px;padding:12px 17px;font-weight:700}.btn.secondary{background:#edf2ff;color:#315ce7}.btn.dark{background:#172842}.btn.green{background:#0a9468}.btn.red{background:#c94051}.btn:disabled{opacity:.55;cursor:default}.input{border:1px solid #d9e0e9;background:#fff;color:#1d2c43;padding:11px;border-radius:10px;width:100%;min-width:0}.field{display:grid;gap:7px}.field label{font-size:13px;font-weight:700;color:#4b5871}.formgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}.toolbar{display:flex;align-items:center;gap:12px;justify-content:space-between;flex-wrap:wrap;margin-bottom:16px}.tablewrap{overflow:auto}.table{border-collapse:collapse;width:100%;font-size:14px;white-space:nowrap}.table th{text-align:left;color:#8290a3;background:#f7f9fc;font-size:12px;text-transform:uppercase;letter-spacing:.4px}.table td,.table th{padding:15px;border-bottom:1px solid #eef1f5}.pill{display:inline-block;padding:5px 11px;border-radius:30px;background:#e9f7ee;color:#218157;font-weight:700;font-size:12px}.pill.warn{background:#fff2da;color:#a56b0c}.pill.gray{background:#f0f2f6;color:#68758c}.columns{display:grid;grid-template-columns:1.4fr 1fr;gap:18px}.screen{max-width:900px;margin:auto}.login{max-width:440px;margin:10vh auto;padding:30px}.login h1{font-size:32px}.stack{display:grid;gap:14px}.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.space{justify-content:space-between}.message{border-radius:12px;padding:12px 14px;background:#edf5ff;color:#244b8d;margin-bottom:16px}.message.err{background:#fff0f0;color:#b12338}.video{background:#0d1b31;border-radius:18px;width:100%;aspect-ratio:4/3;object-fit:cover;transform:scaleX(-1)}.kioskpage{min-height:100vh;background:linear-gradient(130deg,#101c32,#21385e);color:white;padding:25px}.kioskcard{max-width:660px;margin:0 auto;border-radius:26px;background:#ffffff11;border:1px solid #ffffff26;padding:25px;text-align:center}.kioskcard h1{font-size:35px}.kioskcard .input{max-width:480px}.kioskhead{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:20px}.bigtime{font-size:43px;font-weight:800}.kioskactions{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0}.kioskactions .btn{padding:18px 12px;font-size:17px}.banner{background:#102f27;border:1px solid #1fc792;border-radius:12px;padding:20px}.mobileNav{display:none}@media(max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}.columns{grid-template-columns:1fr}.sidebar{width:190px}.main{padding:22px}}@media(max-width:650px){.shell{display:block}.sidebar{position:static;width:100%;height:auto;padding:10px}.sidebar .brand{padding:10px}.sidebar .nav{width:auto;display:inline-block;font-size:12px;padding:9px}.main{padding:16px}.cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.card{padding:14px}.metric{font-size:24px}.formgrid{grid-template-columns:1fr}.top h1{font-size:23px}}

/* WorkPulse installable mobile kiosk */
.wp-kiosk{min-height:100vh;min-height:100dvh;background:linear-gradient(155deg,#101c32 0%,#183155 100%);color:#fff;padding:calc(env(safe-area-inset-top,0px) + 14px) max(16px,env(safe-area-inset-right,0px)) calc(env(safe-area-inset-bottom,0px) + 24px) max(16px,env(safe-area-inset-left,0px));font-family:inherit}
.wp-kiosk-header{max-width:580px;margin:0 auto 16px;display:flex;align-items:center;justify-content:space-between;gap:12px}.wp-kiosk-logo{font-size:23px;letter-spacing:-.7px;font-weight:850}.wp-kiosk-logo span:last-child{color:#56d4b4}.wp-kiosk-symbol{display:inline-block;margin-right:7px;color:#56d4b4}.wp-kiosk-online{font-size:12px;font-weight:750;background:#0c604b;color:#beffdc;padding:7px 12px;border-radius:999px;display:flex;align-items:center;gap:8px}.wp-kiosk-online i{height:7px;width:7px;border-radius:50%;background:#7cffb6}.wp-kiosk-online.is-offline{background:#69333d;color:#ffd0d0}.wp-kiosk-online.is-offline i{background:#ff8a8a}
.wp-kiosk-panel{max-width:580px;margin:0 auto;padding:22px;border:1px solid #ffffff29;border-radius:26px;background:#ffffff12;text-align:center;box-shadow:0 16px 60px #00000020}.wp-kiosk-subtitle{font-size:11px;font-weight:800;letter-spacing:1.8px;color:#c5d7f1}.wp-kiosk-time{font-size:clamp(42px,11vw,62px);line-height:1.2;font-weight:850;letter-spacing:-2px;margin:6px 0}.wp-kiosk-date{font-size:14px;color:#d7e5f5;margin-bottom:20px}.wp-kiosk-preview{background:#0a1527;border:1px solid #ffffff24;width:100%;aspect-ratio:4/3;position:relative;border-radius:20px;overflow:hidden}.wp-kiosk-preview video{height:100%;width:100%;object-fit:cover;transform:scaleX(-1);display:block}.wp-kiosk-overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;background:#0e1e37;color:#eef6ff}.wp-kiosk-face-icon{font-size:70px;color:#69e6c7;line-height:1}.wp-kiosk-overlay strong{font-size:20px}.wp-kiosk-overlay span{font-size:12px;color:#bed1e6}.wp-kiosk-primary{background:#3565eb;border:0;border-radius:13px;color:white;padding:14px 24px;font-weight:800;font-size:16px;cursor:pointer;max-width:100%}.wp-kiosk-scan-frame{position:absolute;inset:12% 24%;border:2px dashed #78edd1;border-radius:45%;pointer-events:none;box-shadow:0 0 0 999px #00000012}.wp-kiosk-processing{position:absolute;inset:0;display:grid;place-items:center;background:#091426a8;font-weight:800;font-size:19px}.wp-kiosk-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.wp-kiosk-actions button{border:0;border-radius:14px;min-height:65px;color:#fff;font-size:18px;font-weight:850;cursor:pointer}.wp-kiosk-in{background:#0a976f}.wp-kiosk-out{background:#d34457}.wp-kiosk-actions button:disabled{opacity:.5;cursor:not-allowed}.wp-kiosk-status{background:#243d63;border:1px solid #7297c84a;color:#e6f2ff;border-radius:12px;margin-top:14px;padding:14px 12px;font-size:14px;line-height:1.5;overflow-wrap:anywhere}.wp-kiosk-status.is-success{background:#124f39;border-color:#61cba3;color:#e0fff2;font-weight:750}.wp-kiosk-status.is-error{background:#662a37;border-color:#e5a0a9;color:#fff0f0}.wp-kiosk-settings{display:block;width:100%;padding:12px;border:0;background:#e5edff;color:#2d59da;border-radius:12px;margin-top:14px;font-weight:750;cursor:pointer}.wp-kiosk-footer{font-size:11px;color:#b9c9dd;line-height:1.6;margin-top:19px}.wp-kiosk-install{display:block;margin:16px auto 0;color:#d7e6ff;border:1px solid #7e93b3;background:#24395c;border-radius:999px;padding:11px 19px;font-size:13px;font-weight:750;cursor:pointer}.wp-kiosk-install-guide{max-width:580px;margin:13px auto 0;border-radius:14px;padding:17px;background:#eff5ff;color:#1d3151;line-height:1.5;font-size:14px}.wp-kiosk-install-guide p{margin:10px 0}.wp-kiosk-install-guide button{padding:9px 15px;border-radius:9px;border:0;background:#315dd9;color:white;font-weight:750}.wp-kiosk-activation{display:grid;gap:12px;text-align:left}.wp-kiosk-camera-placeholder{display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;background:#102241;border:1px dashed #6680a8;border-radius:16px;padding:30px 12px;margin-bottom:9px;font-size:45px}.wp-kiosk-camera-placeholder strong{font-size:18px}.wp-kiosk-camera-placeholder small{font-size:12px;color:#c5d5ef}.wp-kiosk-activation label{font-size:13px;font-weight:750}.wp-kiosk-activation input{height:48px;border-radius:12px;padding:10px 13px;border:1px solid #abbde1;width:100%;font-size:16px;background:#fff;color:#11203a}.wp-kiosk-activation button{width:100%}
@media(max-width:600px){.wp-kiosk{padding-left:12px;padding-right:12px}.wp-kiosk-panel{padding:16px;border-radius:22px}.wp-kiosk-preview{aspect-ratio:3/3.35}.wp-kiosk-date{margin-bottom:16px}.wp-kiosk-actions button{min-height:69px;font-size:16px}.wp-kiosk-header{margin-bottom:14px}.wp-kiosk-scan-frame{inset:16% 16%}}
@media(min-width:700px){.wp-kiosk-preview{aspect-ratio:4/3}}

/* Separate company-owner and kiosk identity surfaces */
.wp-admin-login{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;background:#f7f9fc;color:#192840}.wp-admin-showcase{min-height:100vh;padding:46px clamp(28px,5vw,85px);color:white;background:radial-gradient(circle at 90% 90%,#20577b 0%,transparent 48%),linear-gradient(135deg,#111e36,#1b3155);display:flex;flex-direction:column}.wp-admin-wordmark,.wp-admin-mobile-logo{font-size:25px;letter-spacing:-1px;font-weight:850}.wp-admin-wordmark span,.wp-admin-mobile-logo span{color:#6bdcba}.wp-admin-hero{margin:auto 0}.wp-admin-chip{font-size:11px;color:#a1eed8;font-weight:850;letter-spacing:2px}.wp-admin-hero h1{font-size:clamp(38px,4.3vw,66px);line-height:1.13;letter-spacing:-2.7px;margin:24px 0}.wp-admin-hero em{color:#6bdcba;font-style:normal}.wp-admin-hero p{max-width:440px;color:#cad7eb;font-size:17px;line-height:1.7}.wp-admin-points{display:grid;gap:16px;margin-top:42px;color:#e9fff7;font-size:14px;font-weight:650}.wp-admin-legal{font-size:12px;color:#a7bbd4}.wp-admin-login-right{display:flex;justify-content:center;align-items:center;padding:30px}.wp-admin-login-card{width:100%;max-width:430px;background:#fff;border:1px solid #e8edf4;box-shadow:0 30px 80px #273f5c14;border-radius:25px;padding:clamp(24px,3vw,40px)}.wp-admin-mobile-logo{display:none;color:#13263d;margin-bottom:32px}.wp-admin-eyebrow{font-size:11px;letter-spacing:1.7px;color:#4672c5;font-weight:850}.wp-admin-login-card h2{font-size:34px;letter-spacing:-1.3px;margin:14px 0 8px}.wp-admin-helper{color:#738199;font-size:14px;line-height:1.7;margin:0 0 28px}.wp-admin-login-form{display:grid;gap:10px}.wp-admin-login-form label{font-size:13px;font-weight:750;margin-top:10px}.wp-admin-login-form input{min-height:51px}.wp-admin-submit{margin-top:18px;border:0;border-radius:12px;background:#315ce7;color:#fff;min-height:54px;font-weight:800}.wp-admin-submit:disabled{opacity:.65}.wp-admin-register{text-align:center;color:#6d7c96;font-size:13px;margin-top:20px}.wp-admin-register button{background:none;color:#315ce7;border:none;font-weight:800}.wp-admin-register button:disabled{opacity:.45}.wp-admin-divider{text-align:center;border-top:1px solid #e5ebf3;margin:32px 0 25px;height:1px}.wp-admin-divider span{position:relative;top:-10px;background:white;padding:0 12px;color:#9aa8ba;letter-spacing:1.4px;font-weight:800;font-size:10px}.wp-admin-kiosk-link{display:flex;justify-content:space-between;align-items:center;background:#edf4ff;color:#264d9d;padding:16px;border-radius:12px;font-weight:800}.wp-admin-security{color:#8996ab;text-align:center;font-size:11px;line-height:1.6;margin:22px 0 0}.wp-kiosk-signin{text-align:center;padding-top:8px}.wp-kiosk-activation-icon{height:68px;width:68px;border-radius:19px;background:#284e73;display:grid;place-items:center;font-size:32px;color:#6deac7;margin:0 auto 14px}.wp-kiosk-login-tag{font-size:11px;font-weight:850;letter-spacing:1.8px;color:#83ead0}.wp-kiosk-signin h1{margin:8px 0;font-size:27px;letter-spacing:-.7px}.wp-kiosk-login-text{margin:0 0 17px;line-height:1.7;color:#c4d3ea;font-size:14px}.wp-kiosk-signin label{text-align:left}.wp-kiosk-signin input{margin-bottom:3px}.wp-kiosk-signin .wp-kiosk-primary:disabled{opacity:.5}.wp-kiosk-login-help{border-top:1px solid #ffffff30;padding:20px 0 5px;margin-top:12px;display:grid;gap:6px;font-size:13px}.wp-kiosk-login-help small{color:#bdd1eb;font-size:12px}.wp-kiosk-device-note{border:1px solid #7898c04d;border-radius:12px;background:#183451;padding:14px;color:#d0e3f4;font-size:12px;line-height:1.6}.wp-kiosk-device-banner{display:flex;justify-content:space-between;align-items:center;gap:10px;color:#e1fffa;background:#145a50;border:1px solid #55c9a775;border-radius:12px;padding:9px 12px;font-size:12px;margin:0 0 15px}.wp-kiosk-device-tools{border-radius:13px;background:#183451;padding:15px;font-size:13px;color:#d7e7f8;margin-top:10px}.wp-kiosk-device-tools button{background:#b54057;color:white;border:0;padding:12px 20px;border-radius:10px;font-weight:800}.wp-kiosk-device-tools p{line-height:1.5}@media(max-width:850px){.wp-admin-login{display:block}.wp-admin-showcase{display:none}.wp-admin-login-right{min-height:100vh;min-height:100dvh;padding:18px}.wp-admin-login-card{box-shadow:0 15px 45px #22344b12}.wp-admin-mobile-logo{display:block}}@media(max-width:380px){.wp-admin-login-card{padding:21px}.wp-kiosk-device-banner{flex-direction:column}}


/* WORKPULSE PROFESSIONAL ATTENDANCE DASHBOARD V1 */
.att-dashboard{display:grid;gap:20px;color:#172640}
.att-heading{display:flex;justify-content:space-between;gap:16px;align-items:center}
.att-heading h2{font-size:28px;margin:3px 0 5px;letter-spacing:-.7px}
.att-heading p,.att-list-head p{color:#75859d;margin:0;font-size:14px}
.att-kicker{font-size:11px!important;font-weight:800;letter-spacing:1.3px;color:#138879!important}
.att-refresh,.att-export{border:1px solid #dce4ef;background:white;color:#284565;padding:11px 16px;border-radius:11px;font-weight:750;cursor:pointer}
.att-export{background:#0f766e;color:white;border-color:#0f766e}
.att-panel{background:white;border:1px solid #e3eaf2;border-radius:20px;box-shadow:0 5px 24px #162c4a09}
.att-filter-panel{padding:20px;display:grid;gap:18px}
.att-periods{display:flex;gap:8px;flex-wrap:wrap}
.att-periods button{border:1px solid #dee6f1;border-radius:22px;padding:10px 18px;background:#fff;color:#455771;font-size:13px;font-weight:750;cursor:pointer}
.att-periods button.selected{background:#2447c7;border-color:#2447c7;color:white}
.att-date-row{display:flex;justify-content:space-between;align-items:end;gap:15px;flex-wrap:wrap}
.att-date-label,.att-date-input{display:grid;gap:6px}
.att-date-label span,.att-date-input span{font-size:12px;color:#7c8ca1;font-weight:700}
.att-date-label strong{font-size:15px}
.att-date-input input{border:1px solid #dce5f0;border-radius:10px;padding:10px;font:inherit;color:#263a54;background:white}
.att-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.att-metric{min-height:133px;border-radius:17px;border:1px solid #e1e9f1;background:white;padding:20px;display:grid;align-content:space-between}
.att-metric-title{font-size:13px;font-weight:750;color:#60718a}
.att-metric-value{font-size:34px;font-weight:850;letter-spacing:-1px}
.att-metric-sub{font-size:11px;color:#71829b}
.att-green{background:#f0fbf6}.att-green .att-metric-value{color:#07855e}
.att-blue{background:#f2f7ff}.att-blue .att-metric-value{color:#2755ba}
.att-orange{background:#fff8ef}.att-orange .att-metric-value{color:#b66d13}
.att-list{overflow:hidden}
.att-list-head{padding:22px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.att-list-head h3{font-size:19px;margin:0 0 5px}
.att-toolbar{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:10px;padding:0 24px 20px}
.att-toolbar input,.att-toolbar select{min-width:0;width:100%;border:1px solid #dce5ef;border-radius:10px;padding:12px 13px;background:#fff;color:#344963;font:inherit;font-size:13px}
.att-table-scroll{overflow-x:auto}
.att-table{width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap}
.att-table thead{background:#f5f8fc}
.att-table th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:#71819a;padding:15px 20px}
.att-table td{padding:15px 20px;border-top:1px solid #edf1f6}
.att-person{display:flex;align-items:center;gap:11px}
.att-person strong,.att-person small{display:block}
.att-person small{font-size:11px;color:#8491a4;margin-top:4px}
.att-avatar{width:36px;height:36px;border-radius:12px;background:#dff1f6;color:#08717b;display:grid;place-items:center;font-weight:800}
.att-status{display:inline-block;border-radius:30px;padding:7px 10px;font-size:11px;font-weight:800}
.att-status.working{background:#dcf8e9;color:#087c4e}
.att-status.completed{background:#e7eefb;color:#315998}
.att-status.no-record{background:#fff3e1;color:#af721c}
.att-confidence{width:110px;height:6px;border-radius:10px;background:#e7edf5;overflow:hidden;margin-top:7px}
.att-confidence span{display:block;height:100%;background:#15a57a;border-radius:10px}
.att-warning{display:block;color:#c17a20;margin-top:5px;font-size:10px}
.att-empty{text-align:center;color:#8794a7;padding:35px!important}
.att-table-footer{padding:16px 24px;border-top:1px solid #edf1f6;display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:12px;color:#8491a4}
.att-note{margin:0;font-size:12px;color:#8793a5;line-height:1.6}
@media(max-width:1050px){.att-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.att-toolbar{grid-template-columns:1fr 1fr}.att-toolbar input{grid-column:1/-1}}
@media(max-width:600px){.att-heading{align-items:start}.att-heading h2{font-size:23px}.att-metrics{gap:9px}.att-metric{padding:14px;min-height:110px}.att-metric-value{font-size:27px}.att-filter-panel,.att-list-head{padding:15px}.att-toolbar{grid-template-columns:1fr;padding:0 15px 15px}.att-toolbar input{grid-column:auto}.att-table-footer{padding:14px}.att-periods button{padding:9px 12px;font-size:12px}}

/* PAYROLL PRO POLISH */
.wp-payroll-hero{display:grid;grid-template-columns:1.45fr 1fr;gap:18px;align-items:end;background:linear-gradient(135deg,#ffffff 0%,#f7faff 100%);border:1px solid #e4eaf3;border-radius:22px;padding:22px;box-shadow:0 6px 18px #12243f08;margin-bottom:18px}
.wp-payroll-hero-copy h2{margin:8px 0 8px;font-size:28px;line-height:1.08;letter-spacing:-1px;color:#1a2741}
.wp-payroll-hero-copy p{margin:0;max-width:780px}
.wp-payroll-hero-controls{display:grid;gap:12px;justify-items:end}
.wp-inline-label{font-size:13px;font-weight:700;color:#4b5871}
.wp-summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:18px}
.wp-summary-card{padding:20px 22px}
.wp-summary-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:4px}
.wp-summary-kicker{font-size:13px;font-weight:800;color:#6f7c92;text-transform:uppercase;letter-spacing:.4px}
.wp-summary-icon{min-width:42px;height:42px;display:grid;place-items:center;border-radius:12px;background:#f2f6ff;color:#315ce7;font-size:12px;font-weight:800}
.wp-summary-help{margin-top:7px;color:#758298;font-size:13px;line-height:1.45}
.wp-payroll-layout{display:grid;grid-template-columns:minmax(0,1.65fr) 320px;gap:18px;align-items:start}
.wp-payroll-main h3,.wp-payroll-side h3,.wp-adjust-card h3{font-size:20px;margin-bottom:8px}
.wp-table-legend{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.wp-payroll-table td{vertical-align:top}
.wp-cell-employee{display:grid;gap:3px}
.wp-cell-employee b{font-size:15px}
.wp-type-badge{display:inline-block;padding:5px 10px;border-radius:999px;background:#f1f5fb;color:#50607a;font-size:12px;font-weight:700;text-transform:capitalize}
.wp-review-chip{display:inline-block;padding:6px 11px;border-radius:999px;background:#e9f7ee;color:#218157;font-weight:700;font-size:12px;white-space:nowrap}
.wp-review-chip.warn{background:#fff2da;color:#a56b0c}
.wp-review-chip.approved{background:#e8f1ff;color:#234da9}
.wp-payroll-side{position:sticky;top:24px}
.wp-insight-list{display:grid;gap:10px;margin:10px 0 16px}
.wp-insight-item{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 14px;border:1px solid #e8edf5;border-radius:14px;background:#f9fbff}
.wp-insight-item span{color:#66758c}
.wp-insight-item strong{color:#172842}
.wp-payroll-note{border:1px solid #e8edf5;background:#f8fbff;border-radius:16px;padding:14px 15px;color:#44546c;line-height:1.5}
.wp-payroll-note strong{display:block;margin-bottom:8px;color:#172842}
.wp-payroll-note ul{margin:0;padding-left:18px}
.wp-payroll-note.subtle{margin-top:12px;background:#fffdf7;border-color:#f3e6b3}
.wp-adjust-card{margin-top:18px}
.wp-adjust-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:15px}
.pill.approved{background:#e8f1ff;color:#234da9}
@media(max-width:1100px){
  .wp-payroll-layout{grid-template-columns:1fr}
  .wp-payroll-side{position:static}
  .wp-payroll-hero{grid-template-columns:1fr}
  .wp-payroll-hero-controls{justify-items:start}
}
@media(max-width:900px){
  .wp-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:650px){
  .wp-payroll-hero{padding:18px}
  .wp-payroll-hero-copy h2{font-size:23px}
  .wp-summary-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
  .wp-adjust-grid{grid-template-columns:1fr}
}
