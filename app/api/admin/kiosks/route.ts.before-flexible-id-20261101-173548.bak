import {adminAuth,adminDb,reply} from '@/lib/supabase';
import {randomBytes,createHash} from 'node:crypto';
import {hashPassword} from '@/lib/kiosk-auth';
export const runtime='nodejs';
const password=()=>randomBytes(18).toString('base64url');
const loginId=()=>('KIOSK-'+randomBytes(5).toString('hex')).toUpperCase();
export async function POST(req:Request){try{const a=await adminAuth(req);if(!a)return reply({error:'Unauthorized'},401);const b=await req.json();const name=String(b.name||'').trim();if(name.length<2||name.length>80)return reply({error:'Kiosk name must be 2–80 characters'},400);const login_id=String(b.login_id||'').trim().toUpperCase();
const initialPassword=String(b.password||'');
if(!/^[A-Z0-9-]{6,48}$/.test(login_id))
  return reply({error:'Device ID must be 6–48 characters: A-Z, 0-9 or hyphens'},400);
if(initialPassword.length<10||initialPassword.length>128)
  return reply({error:'Password must be 10–128 characters'},400);
const internalToken=randomBytes(32).toString('hex');const db=adminDb();const {data,error}=await db.from('kiosks').insert({organization_id:a.organization_id,name,login_id,password_hash:hashPassword(initialPassword),token_hash:createHash('sha256').update(internalToken).digest('hex')}).select('id,name,login_id').single();if(error)throw error;await db.from('audit_logs').insert({organization_id:a.organization_id,actor:a.userId,action:'kiosk.created',detail:{kiosk_id:data.id}});return reply({kiosk:data,login_id,password:initialPassword});}catch(e:any){return reply({error:e.message},400)}}
export async function PATCH(req:Request){try{const a=await adminAuth(req);if(!a)return reply({error:'Unauthorized'},401);const b=await req.json();if(typeof b.id!=='string'||!['reset','revoke','enable'].includes(b.action))return reply({error:'Invalid request'},400);const db=adminDb();const patch:any={};let nextPassword:string|undefined;if(b.action==='reset'){nextPassword=password();patch.password_hash=hashPassword(nextPassword);}else patch.active=b.action==='enable';const {data,error}=await db.from('kiosks').update(patch).eq('id',b.id).eq('organization_id',a.organization_id).select('id,name,active,login_id').maybeSingle();if(error)throw error;if(!data)return reply({error:'Kiosk not found'},404);await db.from('audit_logs').insert({organization_id:a.organization_id,actor:a.userId,action:'kiosk.'+b.action,detail:{kiosk_id:b.id}});return reply({ok:true,kiosk:data,...(nextPassword?{password:nextPassword}: {})});}catch(e:any){return reply({error:e.message},400)}}
