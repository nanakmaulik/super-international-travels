'use client';
import {useEffect,useState,useRef} from 'react';
import Image from 'next/image';
import {publicDb} from '@/lib/supabase';
import {payroll,Employee,Event,Adjustment} from '@/lib/payroll';

type View='overview'|'employees'|'attendance'|'payroll'|'kiosks';
type Store={org:string;name:string;employees:Employee[];events:(Event&{id:string;similarity:number|null})[];kiosks:{id:string;name:string;active:boolean}[];adjustments:Adjustment[];runs:any[]};

const money=(v:number)=>'₹'+Number(v||0).toLocaleString('en-IN',{maximumFractionDigits:2});

function BrandLogo({compact=false}:{compact?:boolean}){
  return (
    <div className={compact?'brandLogo compact':'brandLogo'}>
      <Image src="/zavpi-logo.png" alt="Zavpi" width={compact?126:164} height={compact?36:46} priority style={{width:'auto',height:'auto',maxWidth:'100%'}} />
    </div>
  );
}

function Camera({onPhoto}:{onPhoto:(s:string)=>void}){
  const v=useRef<HTMLVideoElement>(null),stream=useRef<MediaStream|null>(null);
  const [err,setErr]=useState('');
  useEffect(()=>{
    let live=true;
    navigator.mediaDevices?.getUserMedia({video:{facingMode:'user',width:800,height:600},audio:false})
      .then(s=>{
        if(!live){s.getTracks().forEach(t=>t.stop());return}
        stream.current=s;
        if(v.current)v.current.srcObject=s
      })
      .catch(e=>setErr(e.message));
    return()=>{live=false;stream.current?.getTracks().forEach(t=>t.stop())}
  },[]);
  return <div className="stack">
    {err
      ? <div className="message err">Camera: {err}. HTTPS and camera permission required.</div>
      : <video ref={v} className="video" autoPlay playsInline muted/>
    }
    <button className="btn" disabled={!!err} onClick={()=>{
      const video=v.current;
      if(!video||!video.videoWidth)return;
      const c=document.createElement('canvas');
      c.width=640;
      c.height=Math.round(video.videoHeight/video.videoWidth*640);
      c.getContext('2d')?.drawImage(video,0,0,c.width,c.height);
      onPhoto(c.toDataURL('image/jpeg',.84))
    }}>Capture Face</button>
  </div>
}

const F=({label,children}:{label:string;children:React.ReactNode})=><div className="field"><label>{label}</label>{children}</div>;

export default function Home(){
  const [db]=useState(()=>publicDb());
  const [token,setToken]=useState(''),
        [email,setEmail]=useState(''),
        [password,setPassword]=useState(''),
        [name,setName]=useState(''),
        [signed,setSigned]=useState(false),
        [store,setStore]=useState<Store|null>(null),
        [view,setView]=useState<View>('overview'),
        [message,setMessage]=useState(''),
        [loading,setLoading]=useState(false),
        [add,setAdd]=useState(false),
        [enroll,setEnroll]=useState<string|null>(null),
        [kioskToken,setKioskToken]=useState(''),
        [newKiosk,setNewKiosk]=useState('Front Desk'),
        [month,setMonth]=useState(new Date().toISOString().slice(0,7)),
        [adjust,setAdjust]=useState(''),
        [adjustValue,setAdjustValue]=useState(''),
        [adjustReason,setAdjustReason]=useState('');

  const [form,setForm]=useState({
    name:'',
    employee_code:'',
    department:'General',
    salary_type:'monthly',
    salary_rate:'30000',
    shift_start:'09:00',
    shift_end:'18:00',
    standard_days:'26',
    overtime_enabled:false,
    overtime_multiplier:'1.5'
  });

  async function api(path:string,body?:unknown,method='POST'){
    const r=await fetch('/api/'+path,{
      method:body?method:'GET',
      headers:{Authorization:`Bearer ${token}`,...(body?{'Content-Type':'application/json'}:{})},
      body:body?JSON.stringify(body):undefined
    });
    const j=await r.json();
    if(!r.ok)throw Error(j.error||'Request failed');
    return j
  }

  async function refresh(access?:string){
    const t=access||token;
    if(!t)return;
    try{
      const r=await fetch('/api/admin',{headers:{Authorization:`Bearer ${t}`},cache:'no-store'});
      const data=await r.json();
      if(!r.ok)throw Error(data.error||'Could not load');
      setStore(data);
      setMessage('');
    }catch(e:any){
      setMessage(e.message);
      setStore(null)
    }
  }

  useEffect(()=>{
    db.auth.getSession().then(({data})=>{
      if(data.session){
        setToken(data.session.access_token);
        setSigned(true);
        refresh(data.session.access_token)
      }
    });
    const {data:{subscription}}=db.auth.onAuthStateChange((_event,session)=>{
      if(session){
        setToken(session.access_token);
        setSigned(true)
      }else{
        setSigned(false);
        setToken('');
        setStore(null)
      }
    });
    return()=>subscription.unsubscribe()
  },[]);

  async function login(register=false){
    setLoading(true);setMessage('');
    try{
      const r=register
        ? await db.auth.signUp({email,password})
        : await db.auth.signInWithPassword({email,password});
      if(r.error)throw r.error;
      if(register){
        setMessage('Account created. Verify your email if confirmation is enabled, then sign in.');
      }else{
        setToken(r.data.session!.access_token);
        setSigned(true);
        await refresh(r.data.session!.access_token)
      }
    }catch(e:any){setMessage(e.message)}
    finally{setLoading(false)}
  }

  async function onboard(){
    setLoading(true);
    try{
      const {error}=await db.rpc('create_my_organization',{org_name:name});
      if(error)throw error;
      await refresh()
    }catch(e:any){setMessage(e.message)}
    finally{setLoading(false)}
  }

  async function execute(path:string,payload:any,done?:()=>void){
    setLoading(true);setMessage('');
    try{
      const result=await api(path,payload);
      done?.();
      await refresh();
      return result
    }catch(e:any){setMessage(e.message)}
    finally{setLoading(false)}
  }

  const events=store?.events||[],
        emps=store?.employees||[],
        today=new Date().toISOString().slice(0,10);

  const todayEvents=events.filter(e=>e.happened_at.slice(0,10)===today);
  const seen=new Set(todayEvents.filter(e=>e.event_type==='in').map(e=>e.employee_id));
  const active=emps.filter(e=>e.active).length;
  const present=emps.filter(e=>{
    const latest=events.find(v=>v.employee_id===e.id);
    return latest?.event_type==='in'
  }).length;

  const lines=payroll(emps,events,store?.adjustments||[],month);
  const approved=store?.runs?.find(r=>r.month===month&&r.status==='approved');

  function exportCsv(){
    const header='Employee ID,Name,Hours,Base,Overtime,Adjustments,Total,Missing punches';
    const text=[header,...lines.map(r=>[
      r.employee_code,r.name,r.hours,r.base_pay,r.ot_pay,r.adjustment,r.total,r.unpaired
    ].map(x=>`"${String(x).replaceAll('"','""')}"`).join(','))].join('\n');
    const blob=new Blob([text],{type:'text/csv'});
    const url=URL.createObjectURL(blob),a=document.createElement('a');
    a.href=url;
    a.download=`zavpi-payroll-${month}.csv`;
    a.click();
    URL.revokeObjectURL(url)
  }

  if(!signed)return <div className="login card stack">
    <BrandLogo />
    <h1>Run your workforce smarter.</h1>
    <p className="muted">Face attendance • Shared kiosk • Automated payroll</p>
    {message&&<div className="message err">{message}</div>}
    <F label="Work Email"><input className="input" type="email" value={email} onChange={e=>setEmail(e.target.value)}/></F>
    <F label="Password"><input className="input" type="password" value={password} onChange={e=>setPassword(e.target.value)}/></F>
    <button className="btn" disabled={loading} onClick={()=>login()}>Sign In</button>
    <button className="btn secondary" disabled={loading} onClick={()=>login(true)}>Create Account</button>
    <a className="muted" href="/kiosk">Open Office Kiosk →</a>
  </div>;

  if(!store)return <div className="login card stack">
    <BrandLogo />
    <h1>Welcome to Zavpi</h1>
    {message&&<div className="message err">{message}</div>}
    <p>Create your company workspace, or refresh if you've already joined one.</p>
    <F label="Company Name"><input className="input" placeholder="ABC Manufacturing" value={name} onChange={e=>setName(e.target.value)}/></F>
    <button className="btn" disabled={loading} onClick={onboard}>Create Company</button>
    <button className="btn secondary" onClick={()=>refresh()}>Refresh Workspace</button>
    <button className="btn secondary" onClick={()=>db.auth.signOut()}>Sign Out</button>
  </div>;

  return <div className="shell">
    <aside className="sidebar">
      <BrandLogo compact />
      <div className="eyebrow" style={{padding:'0 12px 12px',color:'#9eacc0'}}>{store.name}</div>
      {(['overview','employees','attendance','payroll','kiosks'] as View[]).map(v=>
        <button key={v} className={`nav ${view===v?'active':''}`} onClick={()=>{setView(v);setMessage('')}}>
          {({overview:'▦ Dashboard',employees:'♙ Employees',attendance:'◷ Attendance',payroll:'▤ Payroll',kiosks:'▣ Office Kiosks'} as any)[v]}
        </button>
      )}
      <a href="/kiosk" className="nav" style={{display:'block'}}>↗ Open Kiosk</a>
      <button className="nav" onClick={()=>db.auth.signOut()}>↩ Sign out</button>
    </aside>

    <main className="main">
      <div className="top">
        <div>
          <div className="eyebrow">WORKFORCE MANAGEMENT</div>
          <h1>{({overview:'Dashboard',employees:'Employees',attendance:'Attendance Log',payroll:'Monthly Payroll',kiosks:'Office Kiosks'} as any)[view]}</h1>
        </div>
        <div className="row">
          <span className="badge">● Connected</span>
          <button className="btn secondary" onClick={()=>refresh()}>↻ Refresh</button>
        </div>
      </div>

      {message&&<div className="message err">{message}</div>}

      {view==='overview'&&<>
        <div className="cards">
          <div className="card"><div className="eyebrow">Total employees</div><div className="metric">{active}</div><span className="muted">Active staff</span></div>
          <div className="card"><div className="eyebrow">Currently in office</div><div className="metric" style={{color:'#0c936c'}}>{present}</div><span className="muted">Open shifts</span></div>
          <div className="card"><div className="eyebrow">Clock-ins today</div><div className="metric">{seen.size}</div><span className="muted">Unique employees</span></div>
          <div className="card"><div className="eyebrow">Registered kiosks</div><div className="metric">{store.kiosks.length}</div><span className="muted">Devices</span></div>
        </div>

        <div className="columns">
          <section className="card">
            <div className="toolbar">
              <h3>Latest attendance activity</h3>
              <button className="btn secondary" onClick={()=>setView('attendance')}>See all</button>
            </div>
            <div className="tablewrap">
              <table className="table">
                <thead><tr><th>Employee</th><th>Event</th><th>Time</th></tr></thead>
                <tbody>
                  {events.slice(0,9).map(e=>
                    <tr key={e.id}>
                      <td>{emps.find(x=>x.id===e.employee_id)?.name||'Employee'}</td>
                      <td><span className={`pill ${e.event_type==='out'?'gray':''}`}>{e.event_type==='in'?'Clock In':'Clock Out'}</span></td>
                      <td>{new Date(e.happened_at).toLocaleString()}</td>
                    </tr>
                  )}
                </tbody>
              </table>
              {!events.length&&<p className="muted">No attendance yet. Enroll employees and activate kiosk to start.</p>}
            </div>
          </section>

          <section className="card">
            <h3>How to get started</h3>
            <div className="stack">
              <p>① Add your first employee and salary.</p>
              <p>② Enroll their face with camera.</p>
              <p>③ Create an office device ID and password.</p>
              <p>④ Open /kiosk on the office device.</p>
              <p>⑤ Clock in and out with face verification.</p>
              <p>⑥ Review monthly payroll and approve.</p>
            </div>
          </section>
        </div>
      </>}

      {view==='employees'&&<>
        <div className="toolbar">
          <p className="muted">Manage salary, shifts and biometric enrollment.</p>
          <button className="btn" onClick={()=>setAdd(v=>!v)}>{add?'Close':'＋ Add Employee'}</button>
        </div>

        {add&&<section className="card stack" style={{marginBottom:18}}>
          <h3>Add employee</h3>
          <div className="formgrid">
            <F label="Full name"><input className="input" value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/></F>
            <F label="Employee ID"><input className="input" value={form.employee_code} onChange={e=>setForm({...form,employee_code:e.target.value})}/></F>
            <F label="Department"><input className="input" value={form.department} onChange={e=>setForm({...form,department:e.target.value})}/></F>
            <F label="Salary type"><select className="input" value={form.salary_type} onChange={e=>setForm({...form,salary_type:e.target.value})}><option value="monthly">Monthly</option><option value="hourly">Hourly</option></select></F>
            <F label="Salary / hourly rate"><input className="input" type="number" value={form.salary_rate} onChange={e=>setForm({...form,salary_rate:e.target.value})}/></F>
            <F label="Shift start"><input className="input" type="time" value={form.shift_start} onChange={e=>setForm({...form,shift_start:e.target.value})}/></F>
            <F label="Shift end"><input className="input" type="time" value={form.shift_end} onChange={e=>setForm({...form,shift_end:e.target.value})}/></F>
            <F label="Standard working days / month"><input className="input" type="number" value={form.standard_days} onChange={e=>setForm({...form,standard_days:e.target.value})}/></F>
            <F label="Overtime multiplier"><input className="input" type="number" step="0.1" value={form.overtime_multiplier} onChange={e=>setForm({...form,overtime_multiplier:e.target.value})}/></F>
            <F label="Overtime enabled"><select className="input" value={form.overtime_enabled?'yes':'no'} onChange={e=>setForm({...form,overtime_enabled:e.target.value==='yes'})}><option value="no">No</option><option value="yes">Yes</option></select></F>
          </div>
          <button className="btn" disabled={loading||!form.name||!form.employee_code} onClick={()=>{
            execute('admin/employees',{
              name:form.name,
              employee_code:form.employee_code,
              department:form.department,
              salary_type:form.salary_type,
              salary_rate:Number(form.salary_rate),
              shift_start:form.shift_start,
              shift_end:form.shift_end,
              standard_days:Number(form.standard_days),
              overtime_enabled:form.overtime_enabled,
              overtime_multiplier:Number(form.overtime_multiplier)
            },()=>{
              setAdd(false);
              setForm({name:'',employee_code:'',department:'General',salary_type:'monthly',salary_rate:'30000',shift_start:'09:00',shift_end:'18:00',standard_days:'26',overtime_enabled:false,overtime_multiplier:'1.5'})
            })
          }}>Save employee</button>
        </section>}

        <section className="card">
          <div className="tablewrap">
            <table className="table">
              <thead><tr><th>Employee</th><th>Department</th><th>Compensation</th><th>Face</th><th>Actions</th></tr></thead>
              <tbody>
                {emps.map(e=>
                  <tr key={e.id}>
                    <td><strong>{e.name}</strong><br/><span className="muted">{e.employee_code}</span></td>
                    <td>{e.department}</td>
                    <td>{e.salary_type==='monthly'?money(e.salary_rate)+'/month':money(e.salary_rate)+'/hour'}</td>
                    <td><span className={`pill ${!e.face_id?'warn':''}`}>{!!e.face_id?'Enrolled':'Pending'}</span></td>
                    <td className="row">
                      <button className="btn secondary" onClick={()=>setEnroll(e.id)}>Enroll Face</button>
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </section>

        {enroll&&<section className="card" style={{marginTop:18}}>
          <h3>Enroll face: {emps.find(x=>x.id===enroll)?.name}</h3>
          <p className="muted">One employee in the frame. Obtain authorization before enrollment.</p>
          <Camera onPhoto={(img)=>execute('admin/enroll',{employee_id:enroll,image:img})}/>
        </section>}
      </>}

      {view==='attendance'&&<section className="card">
        <div className="toolbar">
          <div>
            <h3>Recorded face attendance events</h3>
            <p className="muted" style={{margin:'8px 0 0'}}>Events are immutable; no manual modification in this version.</p>
          </div>
        </div>
        <div className="tablewrap">
          <table className="table">
            <thead><tr><th>Employee</th><th>Event</th><th>Timestamp</th><th>Recognition</th></tr></thead>
            <tbody>
              {events.map(e=>
                <tr key={e.id}>
                  <td>{emps.find(x=>x.id===e.employee_id)?.name||'Employee'}</td>
                  <td><span className={`pill ${e.event_type==='out'?'gray':''}`}>{e.event_type==='in'?'IN':'OUT'}</span></td>
                  <td>{new Date(e.happened_at).toLocaleString()}</td>
                  <td>{e.similarity!=null?(e.similarity*100).toFixed(1)+'%':'—'}</td>
                </tr>
              )}
            </tbody>
          </table>
        </div>
      </section>}

      {view==='payroll'&&<>
        <div className="toolbar">
          <div className="row">
            <label className="eyebrow">Payroll month</label>
            <input className="input" type="month" value={month} onChange={e=>setMonth(e.target.value)} style={{width:180}}/>
            {approved&&<span className="pill">Approved</span>}
          </div>
          <div className="row">
            <button className="btn secondary" onClick={exportCsv}>Export CSV</button>
            <button className="btn green" disabled={!!approved||loading} onClick={()=>execute('admin/payroll',{month,approve:true})}>Approve Payroll</button>
          </div>
        </div>

        <div className="cards">
          <div className="card"><div className="eyebrow">Payroll total</div><div className="metric">{money(lines.reduce((a,b)=>a+b.total,0))}</div></div>
          <div className="card"><div className="eyebrow">Eligible employees</div><div className="metric">{lines.length}</div></div>
          <div className="card"><div className="eyebrow">Worked hours</div><div className="metric">{lines.reduce((a,b)=>a+b.hours,0).toFixed(1)}</div></div>
          <div className="card"><div className="eyebrow">Unpaired punches</div><div className="metric" style={{color:'#c45a3f'}}>{lines.reduce((a,b)=>a+b.unpaired,0)}</div></div>
        </div>

        <section className="card" style={{marginTop:18}}>
          <h3>Payroll breakdown</h3>
          <p className="muted">Review before final approval.</p>
          <div className="tablewrap">
            <table className="table">
              <thead><tr><th>Employee</th><th>Hours</th><th>Base</th><th>OT</th><th>Adjustments</th><th>Total</th><th>Review</th></tr></thead>
              <tbody>
                {lines.map(r=>
                  <tr key={r.id}>
                    <td><strong>{r.name}</strong><br/><span className="muted">{r.salary_type}</span></td>
                    <td>{r.hours}</td>
                    <td>{money(r.base_pay)}</td>
                    <td>{money(r.ot_pay)}</td>
                    <td>{money(r.adjustment)}</td>
                    <td><strong>{money(r.total)}</strong></td>
                    <td>{r.unpaired? <span className="pill warn">{r.unpaired} missing punches</span>:<span className="pill">Matched</span>}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </section>

        <div className="card stack" style={{marginTop:18}}>
          <h3>Add manual adjustment / bonus / deduction</h3>
          <div className="formgrid">
            <F label="Employee">
              <select className="input" value={adjust} onChange={e=>setAdjust(e.target.value)}>
                <option value="">Select employee</option>
                {emps.map(e=><option key={e.id} value={e.id}>{e.name}</option>)}
              </select>
            </F>
            <F label="Amount (negative for deduction)"><input className="input" type="number" value={adjustValue} onChange={e=>setAdjustValue(e.target.value)}/></F>
          </div>
          <F label="Reason"><input className="input" value={adjustReason} onChange={e=>setAdjustReason(e.target.value)}/></F>
          <button className="btn" disabled={!adjust||!!approved||loading} onClick={()=>execute('admin/adjustments',{employee_id:adjust,amount:Number(adjustValue),month,reason:adjustReason},()=>{setAdjustValue('');setAdjustReason('')})}>Save Adjustment</button>
        </div>
      </>}

      {view==='kiosks'&&<div className="columns">
        <section className="card stack">
          <h3>Register an office kiosk</h3>
          <p className="muted">Each office phone receives a unique secret token. Save it immediately — it is shown once.</p>
          <F label="Kiosk name"><input className="input" value={newKiosk} onChange={e=>setNewKiosk(e.target.value)}/></F>
          <button className="btn" disabled={loading} onClick={async()=>{const r=await execute('admin/kiosks',{name:newKiosk});if(r)setKioskToken(r.token)}}>Generate Kiosk Token</button>
          {kioskToken&&<div className="message"><strong>Copy this token now:</strong><textarea readOnly className="input" value={kioskToken} rows={3}/><button className="btn secondary" onClick={()=>navigator.clipboard.writeText(kioskToken)}>Copy Token</button></div>}
          <a href="/kiosk" className="btn secondary" style={{textAlign:'center'}}>Open Kiosk Interface ↗</a>
        </section>
        <section className="card">
          <h3>Registered devices</h3>
          {store.kiosks.map(k=><p key={k.id}><span className="pill">Active</span> &nbsp; {k.name}</p>)}
          {!store.kiosks.length&&<p className="muted">No kiosks configured.</p>}
        </section>
      </div>}
    </main>
  </div>
}
