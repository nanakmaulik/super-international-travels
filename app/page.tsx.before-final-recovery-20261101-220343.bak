'use client';
import EmployeesDirectory from './EmployeesDirectory';
import OverviewDashboard from './OverviewDashboard';
import AttendanceDashboard from './AttendanceDashboard';
import {useEffect,useState,useRef} from 'react';import {publicDb} from '@/lib/supabase';import {payroll,Employee,Event,Adjustment} from '@/lib/payroll';
type View='overview'|'employees'|'attendance'|'payroll'|'kiosks';type Store={org:string;name:string;employees:Employee[];events:(Event&{id:string;similarity:number|null})[];kiosks:{id:string;name:string;active:boolean}[];adjustments:Adjustment[];runs:any[]};
const money=(v:number)=>'₹'+Number(v||0).toLocaleString('en-IN',{maximumFractionDigits:2});
function Camera({onPhoto}:{onPhoto:(s:string)=>void}){const v=useRef<HTMLVideoElement>(null),stream=useRef<MediaStream|null>(null);const [err,setErr]=useState('');useEffect(()=>{let live=true;navigator.mediaDevices?.getUserMedia({video:{facingMode:'user',width:800,height:600},audio:false}).then(s=>{if(!live){s.getTracks().forEach(t=>t.stop());return}stream.current=s;if(v.current)v.current.srcObject=s}).catch(e=>setErr(e.message));return()=>{live=false;stream.current?.getTracks().forEach(t=>t.stop())}},[]);return <div className="stack">{err?<div className="message err">Camera: {err}. HTTPS and camera permission required.</div>:<video ref={v} className="video" autoPlay playsInline muted/>}<button className="btn" disabled={!!err} onClick={()=>{const video=v.current;if(!video||!video.videoWidth)return;const c=document.createElement('canvas');c.width=640;c.height=Math.round(video.videoHeight/video.videoWidth*640);c.getContext('2d')?.drawImage(video,0,0,c.width,c.height);onPhoto(c.toDataURL('image/jpeg',.84))}}>Capture Face</button></div>}
const F=({label,children}:{label:string;children:React.ReactNode})=><div className="field"><label>{label}</label>{children}</div>;
export default function Home(){const [db]=useState(()=>publicDb());const [token,setToken]=useState(''),[email,setEmail]=useState(''),[password,setPassword]=useState(''),[name,setName]=useState(''),[signed,setSigned]=useState(false),[store,setStore]=useState<Store|null>(null),[view,setView]=useState<View>('overview'),[message,setMessage]=useState(''),[loading,setLoading]=useState(false),[add,setAdd]=useState(false),[enroll,setEnroll]=useState<string|null>(null),[faceSamples,setFaceSamples]=useState<string[]>([]),[kioskToken,setKioskToken]=useState(''),[kioskId,setKioskId]=useState(''),[newKiosk,setNewKiosk]=useState('Front Desk'),[newDeviceId,setNewDeviceId]=useState(''),[newDevicePassword,setNewDevicePassword]=useState(''),[month,setMonth]=useState(new Date().toISOString().slice(0,7)),[adjust,setAdjust]=useState(''),[adjustValue,setAdjustValue]=useState(''),[adjustReason,setAdjustReason]=useState('');
const [form,setForm]=useState({name:'',employee_code:'',department:'General',salary_type:'monthly',salary_rate:'30000',shift_start:'09:00',shift_end:'18:00',standard_days:'26',overtime_enabled:false,overtime_multiplier:'1.5'});
async function api(path:string,body?:unknown,method='POST'){const r=await fetch('/api/'+path,{method:body?method:'GET',headers:{Authorization:`Bearer ${token}`,...(body?{'Content-Type':'application/json'}:{})},body:body?JSON.stringify(body):undefined});const j=await r.json();if(!r.ok)throw Error(j.error||'Request failed');return j}
async function refresh(access?:string){const t=access||token;if(!t)return;try{const r=await fetch('/api/admin',{headers:{Authorization:`Bearer ${t}`},cache:'no-store'});const data=await r.json();if(!r.ok)throw Error(data.error||'Could not load');setStore(data);setMessage('');}catch(e:any){setMessage(e.message);setStore(null)}}
useEffect(()=>{db.auth.getSession().then(({data})=>{if(data.session){setToken(data.session.access_token);setSigned(true);refresh(data.session.access_token)}});const {data:{subscription}}=db.auth.onAuthStateChange((_event,session)=>{if(session){setToken(session.access_token);setSigned(true)}else{setSigned(false);setToken('');setStore(null)}});return()=>subscription.unsubscribe()},[]);
async function login(register=false){setLoading(true);setMessage('');try{const r=register?await db.auth.signUp({email,password}):await db.auth.signInWithPassword({email,password});if(r.error)throw r.error;if(register){setMessage('Account created. Verify your email if confirmation is enabled, then sign in.')}else{setToken(r.data.session!.access_token);setSigned(true);await refresh(r.data.session!.access_token)}}catch(e:any){setMessage(e.message)}finally{setLoading(false)}}
async function onboard(){setLoading(true);try{const {error}=await db.rpc('create_my_organization',{org_name:name});if(error)throw error;await refresh()}catch(e:any){setMessage(e.message)}finally{setLoading(false)}}
async function execute(path:string,payload:any,done?:(()=>void)|'PATCH'){
setLoading(true);
setMessage('');
try{
  const method=done==='PATCH'?'PATCH':'POST';
  const result=await api(path,payload,method);
  if(typeof done==='function')done();
  await refresh();
  return result;
}catch(e:any){
  setMessage(e.message);
}finally{
  setLoading(false);
}
}
const events=store?.events||[],emps=store?.employees||[],today=new Date().toISOString().slice(0,10);const todayEvents=events.filter(e=>e.happened_at.slice(0,10)===today);const seen=new Set(todayEvents.filter(e=>e.event_type==='in').map(e=>e.employee_id));const active=emps.filter(e=>e.active).length;const present=emps.filter(e=>{const latest=events.find(v=>v.employee_id===e.id);return latest?.event_type==='in'}).length;const lines=payroll(emps,events,store?.adjustments||[],month);const approved=store?.runs?.find(r=>r.month===month&&r.status==='approved');
function exportCsv(){const header='Employee ID,Name,Hours,Base,Overtime,Adjustments,Total,Missing punches';const text=[header,...lines.map(r=>[r.employee_code,r.name,r.hours,r.base_pay,r.ot_pay,r.adjustment,r.total,r.unpaired].map(x=>`"${String(x).replaceAll('"','""')}"`).join(','))].join('\n');const blob=new Blob([text],{type:'text/csv'});const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=`workpulse-payroll-${month}.csv`;a.click();URL.revokeObjectURL(url)}
if(!signed)return <main className="wp-admin-login"><section className="wp-admin-showcase"><div className="wp-admin-wordmark">◉ <img src="/zavpi-logo.png" alt="Zavpi" className="zavpi-brand-image" /></div><div className="wp-admin-hero"><div className="wp-admin-chip">WORKFORCE MANAGEMENT PLATFORM</div><h1>Every shift.<br/>Every employee.<br/><em>All in control.</em></h1><p>One secure command center for attendance, facial enrollment, office devices and payroll.</p><div className="wp-admin-points"><div>✓ Live workforce visibility</div><div>✓ Automated payroll summaries</div><div>✓ Multi-office attendance</div></div></div><div className="wp-admin-legal">Zavpi · Business administration portal</div></section><section className="wp-admin-login-right"><div className="wp-admin-login-card"><div className="wp-admin-mobile-logo">◉ <img src="/zavpi-logo.png" alt="Zavpi" className="zavpi-brand-image" /></div><div className="wp-admin-eyebrow">COMPANY ADMIN PORTAL</div><h2>Welcome back</h2><p className="wp-admin-helper">Sign in to manage your organization, people and payroll.</p>{message&&<div role="alert" className="message err">{message}</div>}<form onSubmit={e=>{e.preventDefault();login()}} className="wp-admin-login-form"><label htmlFor="admin-email">Work email address</label><input id="admin-email" className="input" type="email" autoComplete="email" required value={email} onChange={e=>setEmail(e.target.value)} placeholder="you@company.com"/><label htmlFor="admin-password">Password</label><input id="admin-password" className="input" type="password" autoComplete="current-password" required minLength={6} value={password} onChange={e=>setPassword(e.target.value)} placeholder="Enter your password"/><button type="submit" className="wp-admin-submit" disabled={loading}>{loading?'Signing in…':'Sign in to dashboard →'}</button></form><div className="wp-admin-register">New company? <button type="button" disabled={loading||!email||password.length<6} onClick={()=>login(true)}>Create owner account</button></div><div className="wp-admin-divider"><span>OFFICE DEVICE?</span></div><a className="wp-admin-kiosk-link" href="/kiosk">▣ Open Kiosk Login <span>↗</span></a><p className="wp-admin-security">🔒 Only authorized company owners and administrators can access payroll or employee management.</p></div></section></main>;
if(!store)return <div className="login card stack"><h1>Welcome to Zavpi</h1>{message&&<div className="message err">{message}</div>}<p>Create your company workspace, or refresh if you've already joined one.</p><F label="Company Name"><input className="input" placeholder="ABC Manufacturing" value={name} onChange={e=>setName(e.target.value)}/></F><button className="btn" disabled={loading} onClick={onboard}>Create Company</button><button className="btn secondary" onClick={()=>refresh()}>Refresh Workspace</button><button className="btn secondary" onClick={()=>db.auth.signOut()}>Sign Out</button></div>;
return <div className="shell"><aside className="sidebar"><div className="brand"><img src="/zavpi-logo.png" alt="Zavpi" className="zavpi-brand-image" /></div><div className="eyebrow" style={{padding:'0 12px 12px',color:'#9eacc0'}}>{store.name}</div>{(['overview','employees','attendance','payroll','kiosks'] as View[]).map(v=><button key={v} className={`nav ${view===v?'active':''}`} onClick={()=>{setView(v);setMessage('')}}>{({overview:'▦ Dashboard',employees:'♙ Employees',attendance:'◷ Attendance',payroll:'▤ Payroll',kiosks:'▣ Office Kiosks'} as any)[v]}</button>)}<a href="/kiosk" className="nav" style={{display:'block'}}>↗ Open Kiosk</a><button className="nav" onClick={()=>db.auth.signOut()}>↩ Sign out</button></aside><main className="main"><div className="top"><div><div className="eyebrow">WORKFORCE MANAGEMENT</div><h1>{({overview:'Dashboard',employees:'Employees',attendance:'Attendance Log',payroll:'Monthly Payroll',kiosks:'Office Kiosks'} as any)[view]}</h1></div><div className="row"><span className="badge">● Connected</span><button className="btn secondary" onClick={()=>refresh()}>↻ Refresh</button></div></div>{message&&<div className="message err">{message}</div>}
{view==='overview'&&<OverviewDashboard employees={emps} events={events} devices={store.kiosks} company={store.name} onNavigate={setView} onRefresh={()=>refresh()}/>}
{view==='employees'&&<><div className="toolbar"><p className="muted">Manage salary, shifts and biometric enrollment.</p><button className="btn" onClick={()=>setAdd(!add)}>{add?'Close':'＋ Add Employee'}</button></div>{add&&<div className="card stack" style={{marginBottom:18}}><h3>New employee</h3><div className="formgrid">{(['name','employee_code','department','salary_rate','shift_start','shift_end','standard_days','overtime_multiplier'] as const).map(k=><F key={k} label={k.replaceAll('_',' ')}><input className="input" type={['salary_rate','standard_days','overtime_multiplier'].includes(k)?'number':k.startsWith('shift_')?'time':'text'} value={form[k] as string} onChange={e=>setForm({...form,[k]:e.target.value})}/></F>)}<F label="Salary type"><select className="input" value={form.salary_type} onChange={e=>setForm({...form,salary_type:e.target.value})}><option value="monthly">Monthly</option><option value="hourly">Hourly</option></select></F><F label="Overtime"><select className="input" value={form.overtime_enabled?'yes':'no'} onChange={e=>setForm({...form,overtime_enabled:e.target.value==='yes'})}><option value="no">Disabled</option><option value="yes">Enabled</option></select></F></div><button className="btn" disabled={loading} onClick={()=>execute('admin/employees',{...form,salary_rate:Number(form.salary_rate),standard_days:Number(form.standard_days),overtime_multiplier:Number(form.overtime_multiplier)},()=>setAdd(false))}>Save Employee</button></div>}<EmployeesDirectory
 employees={emps}
 onEnroll={(id)=>{
  setFaceSamples([]);
  setEnroll(enroll===id?null:id);
 }}
 onEditSalary={(e)=>{
  const rate=prompt('New salary rate',String(e.salary_rate));
  if(rate!==null&&rate.trim()!==''&&
     Number.isFinite(Number(rate))&&Number(rate)>=0){
   execute('admin/employees',{
    id:e.id,
    salary_rate:Number(rate)
   });
  }
 }}
/>{enroll&&<div className="card stack" style={{maxWidth:440,marginTop:16}}><h3>Enroll face: {emps.find(x=>x.id===enroll)?.name}</h3><p className="muted">One employee in the frame. Obtain authorization before enrollment.</p><p className="muted">Captured {faceSamples.length}/5 samples. Capture front, slight left and slight right (3 minimum).</p><Camera key={enroll} onPhoto={image=>setFaceSamples(a=>a.length<5?[...a,image]:a)}/><div className="row"><button className="btn" disabled={loading||faceSamples.length<3} onClick={()=>execute('admin/enroll',{employee_id:enroll,images:faceSamples},()=>{setEnroll(null);setFaceSamples([])})}>Save {faceSamples.length} Face Samples</button><button className="btn secondary" onClick={()=>setFaceSamples([])}>Retake All</button><button className="btn secondary" onClick={()=>{setEnroll(null);setFaceSamples([])}}>Cancel</button></div></div>}</>}
{view==='attendance'&&<AttendanceDashboard employees={emps} events={events}/>}
{view==='payroll'&&<>
<section className="wp-payroll-hero">
  <div className="wp-payroll-hero-copy">
    <div className="eyebrow">MONTH-END PAYROLL</div>
    <h2>Review, validate and approve monthly payroll with confidence.</h2>
    <p className="muted">See payable totals, identify missing punches, apply manual adjustments and approve payroll only when the month is clean.</p>
  </div>
  <div className="wp-payroll-hero-controls">
    <div className="row">
      <label className="wp-inline-label">Payroll month</label>
      <input className="input" style={{width:190}} type="month" value={month} onChange={e=>setMonth(e.target.value)}/>
      <span className={`pill ${approved?'approved':'warn'}`}>{approved?'Payroll approved':'Draft preview'}</span>
    </div>
    <div className="row">
      <button className="btn secondary" onClick={exportCsv}>Export CSV</button>
      <button
        className="btn green"
        disabled={loading||!!approved||lines.some(l=>l.unpaired>0)}
        onClick={()=>{
          if(confirm('Approve payroll permanently for '+month+'?')) execute('admin/payroll',{month})
        }}
      >
        {approved?'Approved':'Approve Payroll'}
      </button>
    </div>
  </div>
</section>

<div className="wp-summary-grid">
  <section className="card wp-summary-card">
    <div className="wp-summary-head">
      <div className="wp-summary-kicker">Payroll total</div>
      <div className="wp-summary-icon">₹</div>
    </div>
    <div className="metric">{money(lines.reduce((n,l)=>n+l.total,0))}</div>
    <div className="wp-summary-help">Net payable amount for the selected month</div>
  </section>

  <section className="card wp-summary-card">
    <div className="wp-summary-head">
      <div className="wp-summary-kicker">Ready employees</div>
      <div className="wp-summary-icon">EMP</div>
    </div>
    <div className="metric">{lines.filter(l=>l.unpaired===0).length}</div>
    <div className="wp-summary-help">Employees with fully matched in/out punches</div>
  </section>

  <section className="card wp-summary-card">
    <div className="wp-summary-head">
      <div className="wp-summary-kicker">Worked hours</div>
      <div className="wp-summary-icon">HRS</div>
    </div>
    <div className="metric">{lines.reduce((n,l)=>n+l.hours,0).toFixed(1)}</div>
    <div className="wp-summary-help">Verified hours included in this payroll draft</div>
  </section>

  <section className="card wp-summary-card">
    <div className="wp-summary-head">
      <div className="wp-summary-kicker">Needs review</div>
      <div className="wp-summary-icon">!</div>
    </div>
    <div className="metric" style={{color:'#c64c43'}}>{lines.reduce((n,l)=>n+l.unpaired,0)}</div>
    <div className="wp-summary-help">Unpaired punches blocking approval</div>
  </section>
</div>

<div className="wp-payroll-layout">
  <section className="card wp-payroll-main">
    <div className="toolbar">
      <div>
        <h3>Payroll breakdown</h3>
        <p className="muted">Hourly staff are calculated from verified hours × rate. Monthly staff are distributed proportionally across standard monthly hours. Review manual adjustments and resolve missing punches before approval.</p>
      </div>
      <div className="wp-table-legend">
        <span className="pill">Ready to pay</span>
        <span className="pill warn">Needs review</span>
      </div>
    </div>

    <div className="tablewrap">
      <table className="table wp-payroll-table">
        <thead>
          <tr>
            <th>Employee</th>
            <th>Type</th>
            <th>Hours</th>
            <th>Base pay</th>
            <th>Overtime</th>
            <th>Adjustments</th>
            <th>Net pay</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {lines.map(l=>
            <tr key={l.id}>
              <td>
                <div className="wp-cell-employee">
                  <b>{l.name}</b>
                  <span className="muted">Payroll line item</span>
                </div>
              </td>
              <td><span className="wp-type-badge">{l.salary_type}</span></td>
              <td>{l.hours.toFixed(1)}</td>
              <td>{money(l.base_pay)}</td>
              <td>{money(l.ot_pay)}</td>
              <td>{money(l.adjustment)}</td>
              <td><b>{money(l.total)}</b></td>
              <td>
                {approved
                  ? <span className="wp-review-chip approved">Approved</span>
                  : l.unpaired
                    ? <span className="wp-review-chip warn">{l.unpaired} missing punches</span>
                    : <span className="wp-review-chip">Ready</span>}
              </td>
            </tr>
          )}
        </tbody>
      </table>
      {!lines.length && <p className="muted">No payroll data is available for the selected month.</p>}
    </div>
  </section>

  <aside className="card wp-payroll-side">
    <h3>Approval snapshot</h3>
    <div className="wp-insight-list">
      <div className="wp-insight-item">
        <span>Selected month</span>
        <strong>{month}</strong>
      </div>
      <div className="wp-insight-item">
        <span>Eligible employees</span>
        <strong>{lines.length}</strong>
      </div>
      <div className="wp-insight-item">
        <span>Ready to pay</span>
        <strong>{lines.filter(l=>l.unpaired===0).length}</strong>
      </div>
      <div className="wp-insight-item">
        <span>Need attention</span>
        <strong>{lines.filter(l=>l.unpaired>0).length}</strong>
      </div>
      <div className="wp-insight-item">
        <span>Approval status</span>
        <strong>{approved?'Approved':'Pending review'}</strong>
      </div>
    </div>

    <div className="wp-payroll-note">
      <strong>Before approving</strong>
      <ul>
        <li>Resolve all missing punch pairs.</li>
        <li>Review manual bonus / deduction entries.</li>
        <li>Export payroll CSV for finance review if needed.</li>
      </ul>
    </div>

    <div className="wp-payroll-note subtle">
      Approval is disabled until all attendance punch pairs are matched for the selected payroll month.
    </div>
  </aside>
</div>

<section className="card wp-adjust-card">
  <div className="toolbar">
    <div>
      <h3>Manual adjustments</h3>
      <p className="muted">Add a bonus, reimbursement or deduction to the selected employee before payroll approval.</p>
    </div>
  </div>

  <div className="wp-adjust-grid">
    <div className="field">
      <label>Employee</label>
      <select className="input" value={adjust} onChange={e=>setAdjust(e.target.value)}>
        <option value="">Select employee</option>
        {emps.map(e=><option key={e.id} value={e.id}>{e.name}</option>)}
      </select>
    </div>

    <div className="field">
      <label>Amount (use negative value for deduction)</label>
      <input className="input" type="number" value={adjustValue} onChange={e=>setAdjustValue(e.target.value)} placeholder="e.g. 1500 or -500"/>
    </div>
  </div>

  <div className="field" style={{marginTop:14}}>
    <label>Reason</label>
    <input className="input" value={adjustReason} onChange={e=>setAdjustReason(e.target.value)} placeholder="Bonus, travel reimbursement, deduction, advance recovery..."/>
  </div>

  <div className="row" style={{marginTop:16}}>
    <button
      className="btn"
      disabled={!adjust||!!approved||loading}
      onClick={()=>execute('admin/adjustments',{employee_id:adjust,amount:Number(adjustValue),month,reason:adjustReason},()=>{
        setAdjustValue('')
        setAdjustReason('')
      })}
    >
      Save Adjustment
    </button>
    <span className="muted">Changes are applied to the currently selected payroll month.</span>
  </div>
</section>
</>}
{view==='kiosks'&&<div className="columns"><section className="card stack"><h3>Register Attendance Device</h3><p className="muted">Choose your own Device ID and Password. Each attendance phone has separate credentials.</p><F label="Device Name"><input className="input" value={newKiosk} onChange={e=>setNewKiosk(e.target.value)} placeholder="Main Entrance"/></F><F label="Attendance Device ID"><input className="input" value={newDeviceId} onChange={e=>setNewDeviceId(e.target.value)} placeholder="e.g. Cabin Room 123" autoCapitalize="characters"/></F><F label="Attendance Device Password"><input className="input" type="password" value={newDevicePassword} onChange={e=>setNewDevicePassword(e.target.value)} placeholder="Enter a strong password" autoComplete="new-password"/></F><p className="muted">Device ID: 3–64 characters. Letters, numbers, spaces and symbols allowed. Password: 10–128 characters.</p><button className="btn" disabled={loading||!newDeviceId.trim()||!newDevicePassword} onClick={async()=>{const r=await execute('admin/kiosks',{name:newKiosk,login_id:newDeviceId.trim(),password:newDevicePassword});if(r){setKioskToken(r.password);setKioskId(r.login_id);setNewDevicePassword('')}}}>Create Attendance Device</button>{kioskToken&&<div className="message"><strong>Save these device credentials securely (shown once):</strong><p>Kiosk ID: <code>{kioskId}</code></p><p>Password: <code>{kioskToken}</code></p><button className="btn secondary" onClick={()=>navigator.clipboard.writeText(`Kiosk ID: ${kioskId}\nPassword: ${kioskToken}`)}>Copy Credentials</button></div>}<a href="/kiosk" className="btn secondary" style={{textAlign:'center'}}>Open Kiosk Interface ↗</a></section><section className="card"><h3>Registered devices</h3>{store.kiosks.map(k=><div key={k.id} style={{padding:'12px 0',borderBottom:'1px solid #e6e9f0'}}><strong>{k.name}</strong> <span className="pill">{k.active?'Active':'Revoked'}</span><div className="muted">{(k as any).login_id||'Legacy token device'}</div><div className="row" style={{marginTop:8,flexWrap:'wrap'}}><button className="btn secondary" onClick={async()=>{if(!confirm('Reset kiosk password? Save the new password immediately.'))return;const r=await execute('admin/kiosks',{id:k.id,action:'reset'},'PATCH');if(r){setKioskId((k as any).login_id||'');setKioskToken(r.password)}}}>Reset Password</button><button className="btn secondary" onClick={async()=>{if(!confirm(k.active?'Revoke kiosk access?':'Enable kiosk?'))return;await execute('admin/kiosks',{id:k.id,action:k.active?'revoke':'enable'},'PATCH')}}>{k.active?'Revoke':'Enable'}</button></div></div>)}{!store.kiosks.length&&<p className="muted">No kiosks configured.</p>}</section></div>}
</main></div>}
